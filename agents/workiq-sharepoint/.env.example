# Microsoft Foundry 프로젝트 엔드포인트
# 예: https://<your-account>.services.ai.azure.com/api/projects/<your-project>
AZURE_AI_PROJECT_ENDPOINT=

# Foundry 프로젝트에 등록한 WorkIQ SharePoint Connection 이름
WORKIQ_SHAREPOINT_CONNECTION_NAME=WorkIQSharePoint

# 사용할 모델 배포 이름 (예: gpt-4.1, gpt-4o)
MODEL_DEPLOYMENT_NAME=gpt-4.1

# Foundry 포탈에 등록될 에이전트 이름
AGENT_NAME=workiq-sharepoint-agent

# (선택) 테스트 유저 로그인 시 사용할 Azure 테넌트 ID — 비워두면 기본 테넌트 사용
AZURE_TENANT_ID=
